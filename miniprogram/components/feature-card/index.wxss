.feature-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.icon { font-size: 48rpx; margin-right: 16rpx; }
.name { font-size: 30rpx; font-weight: 600; }
.desc { color: #64748b; font-size: 24rpx; margin-top: 6rpx; }
.arrow { margin-left: auto; color: #94a3b8; font-size: 36rpx; }
